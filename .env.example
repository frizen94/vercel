# ===============================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ===============================================
# Copie este arquivo para .env e configure as variáveis apropriadas

# ===============================================
# 🔐 BANCO DE DADOS (OBRIGATÓRIO)
# ===============================================

# Para desenvolvimento local com Docker:
DATABASE_URL=postgresql://nexustasks_user:nexustasks_password@localhost:5432/nexustasks_db

# Para PostgreSQL local (sem Docker):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/nexustasks_db

# Para Railway (AUTOMÁTICO - não configurar):
# DATABASE_URL será definido automaticamente pelo PostgreSQL add-on do Railway

# ===============================================
# 🔑 SEGURANÇA (OBRIGATÓRIO EM PRODUÇÃO)
# ===============================================

# Chave secreta para sessões (MÍNIMO 32 caracteres)
# ⚠️  DEVE ser alterada em produção!
SESSION_SECRET=minha-chave-secreta-nexustasks-desenvolvimento-local-32-chars-minimo

# ===============================================
# 🚀 CONFIGURAÇÕES DE AMBIENTE
# ===============================================

# Ambiente de execução
NODE_ENV=development

# Porta do servidor (Railway define automaticamente)
PORT=5000

# ===============================================
# 🔒 SSL/TLS (AUTOMÁTICO EM PRODUÇÃO)
# ===============================================

# Forçar SSL no banco (automático no Railway)
# FORCE_DB_SSL=true

# ===============================================
# 📊 RAILWAY - VARIÁVEIS AUTOMÁTICAS
# ===============================================
# Estas variáveis são definidas automaticamente pelo Railway:
# 
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=xxx
# RAILWAY_SERVICE_ID=xxx
# RAILWAY_DEPLOYMENT_ID=xxx
# PORT=8080 (ou outra porta)
# NODE_ENV=production

# ===============================================
# ✅ CHECKLIST PARA RAILWAY DEPLOY
# ===============================================
#
# 1. ✅ Adicionar PostgreSQL add-on no Railway
# 2. ⚠️  Configurar SESSION_SECRET nas Variables do Railway
# 3. ✅ NODE_ENV será "production" automaticamente
# 4. ✅ PORT será definida automaticamente
# 5. ✅ DATABASE_URL será criada pelo PostgreSQL add-on
#
# ÚNICA CONFIGURAÇÃO MANUAL NECESSÁRIA:
# SESSION_SECRET=sua-chave-secreta-de-32-caracteres-ou-mais